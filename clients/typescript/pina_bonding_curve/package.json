{
	"name": "@pina-rs/bonding-curve",
	"version": "0.1.0",
	"description": "TypeScript client for the Pina Bonding Curve: launchpad instruction builders, account decoders, PDAs, events, and errors for @solana/kit",
	"keywords": [
		"solana",
		"bonding-curve",
		"launchpad",
		"pina",
		"solana-kit"
	],
	"homepage": "https://github.com/pina-rs/bonding_curve/tree/main/clients/typescript/pina_bonding_curve",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pina-rs/bonding_curve.git",
		"directory": "clients/typescript/pina_bonding_curve"
	},
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"check": "tsc --noEmit --project tsconfig.json",
		"test": "node --test test/*.test.mjs",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"@solana/program-client-core": "^8.3.0"
	},
	"peerDependencies": {
		"@solana/kit": "^8.3.0"
	},
	"devDependencies": {
		"@solana/kit": "^8.3.0",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"@types/node": "^24.6.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"module": "./dist/index.js"
}
